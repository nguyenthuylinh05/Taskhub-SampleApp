# Application
APP_NAME=TaskHub
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# PostgreSQL
POSTGRES_DB=taskhub_db
POSTGRES_USER=taskhub_user
POSTGRES_PASSWORD=your_local_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_TEST_DB=taskhub_test_db

# JWT
# Generate a secure secret using:
# uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=local-development-only-change-this-secret-before-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TASK_CACHE_TTL_SECONDS=60

LOG_LEVEL=INFO

# Assignment email notifications (disabled by default).
# Set EMAIL_NOTIFICATIONS_ENABLED=true and provide SMTP settings to send email.
EMAIL_NOTIFICATIONS_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SENDER_EMAIL=TaskHub <no-reply@localhost>
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false

# Docker Compose maps this to the application's DEBUG setting to avoid
# collisions with development tools that export a generic DEBUG variable.
TASKHUB_DEBUG=false

# Local API port used by Docker Compose.
APP_PORT=8000
